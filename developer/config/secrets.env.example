# Copy to ~/.config/guidebot/conversation.env and chmod 600.
# Each account supplies its own credentials; do not commit the completed file.
STEP_SECRET=
# Required for the default DeepSeek action planner (voice-only does not need it):
# DEEPSEEK_API_KEY=
# Optional:
# STEP_VOICE=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Action planner defaults to DeepSeek API with a persistent HTTP Session.
GUIDEBOT_PLANNER_PROVIDER=deepseek
# GUIDEBOT_PLANNER_BASE_URL=http://127.0.0.1:8088/v1
# GUIDEBOT_PLANNER_MODEL=qwen3-1.7b
# Optional measured native decoder modes; default off. See docs/setup.md for quality limits.
# GUIDEBOT_QWEN_SPECULATION=ngram-simple
# Faster experimental alternative: ngram-map-k. Restore original decoder with off.
# Optional native local alternative: GUIDEBOT_PLANNER_PROVIDER=local_qwen (see docs/setup.md).
